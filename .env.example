# ===== LLM（内容检测+总结，OpenAI 兼容）=====
# 方式一：ModelScope 免费 API（魔搭）https://modelscope.cn -> 头像 -> API-KEY 管理
DEEPSEEK_API_KEY=
# LLM_BASE_URL=https://api-inference.modelscope.cn/v1
# LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
# LLM_MODEL_FALLBACKS=Qwen/Qwen3.5-122B-A10B,ZhipuAI/GLM-4.7-Flash   # 逗号分隔，免费档限流时自动切换
# 方式二：DeepSeek 官方 https://platform.deepseek.com -> API Keys
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# ===== 抖音开放平台（发布图文）=====
# 获取：https://developer.open-douyin.com 创建应用后获得，见 docs/douyin_open_platform_setup.md
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
# 应用里配置的回调地址，必须与授权时一致
DOUYIN_REDIRECT_URI=https://localhost/callback
# 首次授权后由 `python main.py douyin callback <code>` 写入数据库/环境
DOUYIN_ACCESS_TOKEN=
DOUYIN_REFRESH_TOKEN=
DOUYIN_OPEN_ID=

# ===== 可选：GitHub Actions 部署时回写令牌（复用 DouYinSparkFlow 的 PAT 思路）=====
# GH_WRITEBACK_REPO=你的账号/仓库名
# GH_WRITEBACK_TOKEN=ghp_xxx（repo 权限 PAT）

# ===== 抖音网页版发布（个人账号路线，优先于 API）=====
# 不填则自动找 ~/.config/douyin_keepalive/cookies.json（你已有的 keepalive 设施）
# DOUYIN_WEB_COOKIES=/path/to/cookies.json
# PLAYWRIGHT_EXECUTABLE=/path/to/chrome   # 留空自动发现 Chrome for Testing

# ===== 可选：X(Twitter) 直抓后端 ===== 
# X_COOKIES_PATH=/path/to/x_cookies.json
