# ===== 全局 =====
data_dir: data          # SQLite 数据库与图片输出目录
log_level: INFO
timezone: Asia/Shanghai

# ===== 全局 =====
data_dir: data          # SQLite 数据库与图片输出目录
log_level: INFO
timezone: Asia/Shanghai

# ===== 内容源（多源并行，自动去重；全部为免登录可用源；已剔除在抖音有官方账号的源）=====
sources:
  - type: rss
    name: openai_news
    url: https://openai.com/news/rss.xml
    enabled: true
    max_items: 10

  - type: rss
    name: hf_blog
    url: https://huggingface.co/blog/feed.xml
    enabled: true
    max_items: 10

  - type: rss
    name: deepmind_blog
    url: https://deepmind.google/blog/rss.xml
    enabled: true
    max_items: 10

  - type: rss
    name: techcrunch_ai
    url: https://techcrunch.com/category/artificial-intelligence/feed/
    enabled: true
    max_items: 15

  - type: rss
    name: venturebeat_ai
    url: https://venturebeat.com/category/ai/feed/
    enabled: true
    max_items: 15

  - type: rss
    name: nvidia_blog
    url: https://blogs.nvidia.com/feed/
    enabled: true
    max_items: 10

  - type: rss
    name: mit_tr
    url: https://www.technologyreview.com/feed/
    enabled: true
    max_items: 10

  - type: rss
    name: verge_ai
    url: https://www.theverge.com/rss/ai-artificial-intelligence/index.xml
    enabled: true
    max_items: 10

  - type: googlenews
    name: google_ai
    query: '"OpenAI" OR "Anthropic" OR "Google DeepMind" OR "Meta AI"'   # 纯英文，避免混入抖音活跃的国内媒体
    lang: en-US
    enabled: true
    max_items: 15

  - type: tme
    name: tg_ai_news
    channel: AI_News_Official
    enabled: true
    max_items: 10

  - type: rsshub_twitter
    name: twitter_via_rsshub
    base_url: http://localhost:1200
    accounts: [OpenAI, AnthropicAI, GoogleDeepMind, MetaAI, karpathy, AndrewYNg]
    enabled: false
    max_items: 30

  - type: twitter_x
    name: twitter_x
    accounts: [OpenAI, AnthropicAI]
    cookies_path: ""
    enabled: false
    max_items: 30

# ===== 内容检测 =====
detection:
  relevance:
    threshold: 0.4             # 关键词打分 >= 阈值直接通过；0.2~0.4 交给 LLM 判断；<0.2 丢弃
    extra_keywords: []         # 追加 AI 关键词（英文小写）
  sensitive:
    hard_block: true           # 命中敏感词表直接丢弃
    llm_verify: true           # 是否再让 LLM 复核一遍敏感内容
  dedup:
    text_similarity: 0.82      # 与已发布内容文本相似度 >= 此值视为重复
    recent_posts: 30           # 只与最近 N 篇已发布内容比较
  freshness:
    max_age_hours: 48          # 只发 48 小时内的新闻（保时效）

# ===== DeepSeek 总结 =====
llm:
  model: deepseek-chat
  temperature: 0.4
  max_title_len: 10            # 标题最大字数（英文字母逐个计数，宁短勿超）
  max_body_len: 800            # 正文最大字数（深度模式）
  ai_footer: "—— 本文由 AI 转录整理，仅供参考 ——"   # 文末 AI 生成标识，留空则不加
  max_hashtags: 5